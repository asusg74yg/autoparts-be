model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Supplier {
  id           String   @id @default(uuid())
  name         String
  contact      String?
  emailAddress String?
  brandLabel   String?
  // apiKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // products Product[]
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  orderId   String?
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  files File[]
}

model File {
  id              String         @id @default(uuid())
  urls            String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  SupportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id])
  supportTicketId String?
}

model ShippingLabel {
  id             String   @id @default(uuid())
  orderId        String   @unique
  labelUrl       String?
  trackingNumber String?   @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model CmsPage {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  content   String
  status    CmsStatus @default(DRAFT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  message    String
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}

// -------------------ACES PIES---------------------
// BaseVehicle related models
model BaseVehicle {
  id               String     @id @default(uuid())
  baseVehicleID    Int
  year             Int?
  model            String?
  vehicleType      String?
  vehicleTypeGroup String?
  make             String?
  subModels        SubModel[]
  Product          Product[]
}

model SubModel {
  id            String      @id @default(uuid())
  subModel      String?
  regionAbbr    String?
  regionName    String?
  baseVehicleId String
  // Foreign key to BaseVehicle
  baseVehicle   BaseVehicle @relation(fields: [baseVehicleId], references: [id])
  region        Region[]
}

model Region {
  id         Int      @id @default(autoincrement())
  RegionID   Int?
  ParentID   Int?
  RegionAbbr String?
  RegionName String?
  // Relationship to SubModel
  submodelId String
  subModel   SubModel @relation(fields: [submodelId], references: [id])
}

// -------------------------
// EngineBase related models
model EngineBase {
  id              String    @id @default(uuid())
  engineBaseID    Int
  liter           String?
  cc              String?
  cid             String?
  cylinders       String?
  blockType       String?
  engBoreIn       String?
  engBoreMetric   String?
  engStrokeIn     String?
  engStrokeMetric String?
  Product         Product[]
}

model EngineDesignation {
  id                  String    @id @default(uuid())
  EngineDesignationID Int
  engineDesignation   String?
  Product             Product[]
}

model EngineVersion {
  id              String    @id @default(uuid())
  EngineVersionID Int
  engineVersion   String?
  Product         Product[]
}

model EngineMfr {
  id          String    @id @default(uuid())
  EngineMfrID Int
  engineMfr   String?
  Product     Product[]
}

model FuelType {
  id         String    @id @default(uuid())
  FuelTypeID Int
  fuelType   String?
  Product    Product[]
}

// ------------

// ------------
model BrandAAIAID {
  id            String    @id @default(uuid())
  brandAAIAIDID String
  brandAAIAID   String?
  Product       Product[]
}

// ------------
model Product {
  id                         String                       @id @default(uuid())
  mfrLabel                   String?
  part                       String?
  action                     String?
  hazardMaterialCode         String?
  partNumber                 String?
  brandLabel                 String?
  acesApplications           String?
  itemQuantitySize           Int?
  containerType              String?
  quantityPerApplication     Int?
  minimumOrderQuantity       Int?
  partTerminologyId          Int
  productDescription         ProductDescription[]
  pricing                    Pricing[]
  productAttributes          ProductAttribute[]
  extendedProductInformation ExtendedProductInformation[]
  package                    Package?
  digitalAssets              DigitalAsset[]
  maintenanceType            String?
  partType                   PartType?
  partTypeId                 String?
  orderItems                 OrderItem[]
  reviews                    Review[]
  baseVehicleId              String
  engineBaseId               String
  engineDesignationId        String
  engineVersionId            String
  engineMfrId                String
  fuelTypeId                 String
  brandAAIAIDId              String
  baseVehicle                BaseVehicle                  @relation(fields: [baseVehicleId], references: [id])
  engineBase                 EngineBase                   @relation(fields: [engineBaseId], references: [id])
  engineDesignation          EngineDesignation            @relation(fields: [engineDesignationId], references: [id])
  engineVersion              EngineVersion                @relation(fields: [engineVersionId], references: [id])
  engineMfr                  EngineMfr                    @relation(fields: [engineMfrId], references: [id])
  fuelType                   FuelType                     @relation(fields: [fuelTypeId], references: [id])
  brandAAIAID                BrandAAIAID                  @relation(fields: [brandAAIAIDId], references: [id])
  rating                     Float?                       @default(0)
}

model PartType {
  id                  String   @id @default(uuid())
  partTypeID          Int
  partTypeName        String?
  partTypeDescription String?
  category            String?
  subcategory         String?
  productId           String?  @unique
  product             Product? @relation(fields: [productId], references: [id])
}

model ProductDescription {
  id              String  @id @default(uuid())
  descriptionText String?
  descriptionCode String?
  maintenanceType String?
  languageCode    String?
  productId       String
  sequence        Int?
  product         Product @relation(fields: [productId], references: [id])
}

model Pricing {
  id               String  @id @default(uuid())
  priceSheetNumber String?
  currencyCode     String?
  price            Float?
  priceType        String?
  maintenanceType  String?
  productId        String
  product          Product @relation(fields: [productId], references: [id])
}

model ProductAttribute {
  id                 String  @id @default(uuid())
  attributeID        String?
  padbAttribute      String?
  recordNumber       Int?
  multiValueQuantity Int?
  multiValueSequence Int?
  languageCode       String?
  productId          String
  product            Product @relation(fields: [productId], references: [id])
}

model ExtendedProductInformation {
  id              String  @id @default(uuid())
  expiCode        String?
  descriptionText String?
  maintenanceType String?
  languageCode    String?
  productId       String
  product         Product @relation(fields: [productId], references: [id])
}

model Package {
  id               String  @id @default(uuid())
  packageID        Int?
  packageUOM       String?
  quantityOfEaches Int?
  dimensionsHeight Float?
  dimensionsWidth  Float?
  dimensionsLength Float?
  packageWeight    Float?
  weightUOM        String?
  maintenanceType  String?
  productId        String  @unique
  product          Product @relation(fields: [productId], references: [id])
}

model DigitalAsset {
  id              String  @id @default(uuid())
  fileName        String?
  assetType       String?
  fileType        String?
  uri             String
  country         String?
  maintenanceType String?
  productId       String
  product         Product @relation(fields: [productId], references: [id])
}
