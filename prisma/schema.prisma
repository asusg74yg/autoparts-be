// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  USER
  SUPPLIER
}

enum TicketStatus {
  OPEN
  CLOSED
  PENDING
}

enum ShippingStatus {
  PENDING
  SHIPPED
  RETURNED
  DELIVERED
}

enum CmsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id             String          @id @default(uuid())
  role           Role
  businessName   String?
  contactName    String
  email          String          @unique
  phone          String?
  address        String?
  country        String?
  passwordHash   String
  refreshToken   String?
  otpCode        BigInt?
  otpExpiresAt   DateTime?
  emailVerified  Boolean         @default(false)
  approved       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  vehicles       Vehicle[]
  orders         Order[]
  supportTickets SupportTicket[]
  activityLogs   ActivityLog[]
  review         Review[]
}

model Vehicle {
  id        String   @id @default(uuid())
  userId    String
  brand     String
  model     String
  year      Int
  make      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     Int            @default(autoincrement()) @unique
  userId          String?
  shippingStatus  ShippingStatus @default(PENDING)
  shippingCost    Float? @default(0)
  stripeSessionId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user           User?             @relation(fields: [userId], references: [id])
  items          OrderItem[]
  additionalInfo AdditionalOrder[]
  shippingLabel  ShippingLabel?
  supportTickets SupportTicket[]
}

model AdditionalOrder {
  id                String @id @default(uuid())
  orderId           String
  order             Order  @relation(fields: [orderId], references: [id])
  shipping_fullName String
  shipping_email    String
  shipping_address  String
  shipping_city     String
  shipping_state    String
  shipping_zipCode  String @db.VarChar(5)
  shipping_country  String
  shipping_phone    String @db.VarChar(15)

  // Billing information (optional)
  billing_fullName String?
  billing_email    String?
  billing_address  String?
  billing_city     String?
  billing_state    String?
  billing_zipCode  String?  @db.VarChar(5)
  billing_country  String?
  billing_phone    String?  @db.VarChar(15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Promotion {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  priceType String?
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

